// Разметка интерфейса. Это отдельный DSL, чем-то похожий на XAML, но с выражениями и привязками.
import { Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Game of Life";
    background: #000000;

    // `in`     - Rust задаёт значение, UI только читает
    // `in-out` - читают и пишут обе стороны
    in property <[bool]> cells;     // плоский массив клеток (true = жива)
    in property <int> cols;
    in property <int> rows;
    in property <int> generation;
    in-out property <bool> running: false;

    // Колбэки: в Rust для `toggle-cell` будет сгенерирован метод `on_toggle_cell(...)`
    callback toggle-cell(int);
    callback step();
    callback randomize();
    callback toggle-all();
    callback clear();

    // Приватное свойство, наружу не видно
    property <length> cell-size: 16px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: start;

        Text {
            text: "Поколение: " + root.generation;
            color: white;
            font-size: 18px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;

            // Поле. Клетки раскладываем вручную: из индекса i получаем строку и столбец.
            Rectangle {
                width: root.cols * root.cell-size;
                height: root.rows * root.cell-size;

                // `for alive[i] in cells` - как @foreach, но с привязкой:
                // когда Rust меняет модель, перерисовываются только изменённые клетки.
                for alive[i] in root.cells : Rectangle {
                    x: Math.mod(i, root.cols) * root.cell-size;
                    y: Math.floor(i / root.cols) * root.cell-size;
                    width: root.cell-size;
                    height: root.cell-size;

                    background: alive ? #ed9632 : #171717;
                    border-width: 1px;
                    border-color: #000000;

                    border-radius: 0px;

                    //animate background { duration: 120ms; }

                    TouchArea {
                        clicked => { root.toggle-cell(i); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            Button {
                text: root.running ? "Пауза" : "Старт";
                // Простую UI-логику можно писать прямо в .slint, без похода в Rust
                clicked => { root.running = !root.running; }
            }
            Button {
                text: "Шаг";
                enabled: !root.running;
                clicked => { root.step(); }
            }
            Button {
                text: "Случайно";
                clicked => { root.randomize(); }
            }
            Button {
                text: "Очистить";
                clicked => { root.clear(); }
            }
            Button {
                text: "Toggle all";
                clicked => { root.toggle-all(); }
            }
        }
    }
}
